MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-flash
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_SECONDS=60
MAX_FRAMES=20
FRAME_CONCURRENCY=3
ASR_PROVIDER=disabled
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
ASR_API_KEY=
ASR_BASE_URL=https://dashscope.aliyuncs.com
ASR_TIMEOUT_SECONDS=180
ASR_POLL_INTERVAL_SECONDS=3
ASR_MAX_RETRIES=2
ASR_LANGUAGE_HINT=zh
ASR_ENABLE_WORDS=true
ASR_MEDIA_MODE=public_url
# Public read-only base URL reachable by DashScope, including any reverse-proxy prefix.
ASR_PUBLIC_BASE_URL=
CONTENT_FIXTURE_ENABLED=false
# Optional. If omitted, stream probing falls back to the bundled ffmpeg.
FFPROBE_PATH=
HOST=127.0.0.1
PORT=8765
