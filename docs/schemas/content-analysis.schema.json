{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:framelab:content-analysis:1.0",
  "title": "Content analysis v0.3 — design-only contract",
  "description": "规划契约，当前运行时未接入。Schema 不替代 SPEC 中的引用、时间、来源与语义交叉校验。",
  "oneOf": [
    {
      "$ref": "#/$defs/Transcript"
    },
    {
      "$ref": "#/$defs/Report"
    }
  ],
  "$defs": {
    "Evidence": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "transcript_segment",
            "transcript_word",
            "transcript_result",
            "visual_observation",
            "metadata"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "quote"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 0,
          "maxItems": 40
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "value",
        "basis",
        "evidence",
        "note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Word": {
      "type": "object",
      "properties": {
        "word_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "word_id",
        "text",
        "start_ms",
        "end_ms"
      ],
      "additionalProperties": false
    },
    "TranscriptSegment": {
      "type": "object",
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "segment_id",
        "text",
        "start_ms",
        "end_ms",
        "words"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0
            },
            "end_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "start_ms": {
              "type": "null"
            },
            "end_ms": {
              "type": "null"
            }
          }
        }
      ]
    },
    "Transcript": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "content-1.0"
        },
        "kind": {
          "const": "transcript"
        },
        "transcript_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "video_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "source": {
          "enum": [
            "asr",
            "manual",
            "fixture",
            "media_probe"
          ]
        },
        "content_basis": {
          "enum": [
            "speech",
            "subtitle",
            "unverified"
          ]
        },
        "outcome": {
          "enum": [
            "text_available",
            "no_audio",
            "no_speech",
            "unintelligible"
          ]
        },
        "timing": {
          "enum": [
            "word",
            "sentence",
            "none"
          ]
        },
        "timestamp_origin": {
          "const": "video_start"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptSegment"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "input_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "derived_from_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "is_fixture": {
          "type": "boolean"
        },
        "reviewed_by_human": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 40
        }
      },
      "required": [
        "schema_version",
        "kind",
        "transcript_id",
        "video_id",
        "duration_ms",
        "source",
        "content_basis",
        "outcome",
        "timing",
        "timestamp_origin",
        "provider",
        "model",
        "language",
        "segments",
        "input_sha256",
        "derived_from_id",
        "is_fixture",
        "reviewed_by_human",
        "warnings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "fixture"
              }
            }
          },
          "then": {
            "properties": {
              "is_fixture": {
                "const": true
              },
              "reviewed_by_human": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "is_fixture": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "asr"
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "content_basis": {
                "const": "speech"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "media_probe"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "no_audio"
              },
              "content_basis": {
                "const": "unverified"
              },
              "provider": {
                "type": "null"
              },
              "model": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "text_available"
              }
            }
          },
          "then": {
            "properties": {
              "segments": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "segments": {
                "maxItems": 0
              },
              "timing": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timing": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "segments": {
                "items": {
                  "properties": {
                    "start_ms": {
                      "type": "null"
                    },
                    "end_ms": {
                      "type": "null"
                    },
                    "words": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timing": {
                "const": "sentence"
              }
            }
          },
          "then": {
            "properties": {
              "segments": {
                "items": {
                  "properties": {
                    "start_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "words": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "timing": {
                "const": "word"
              }
            }
          },
          "then": {
            "properties": {
              "segments": {
                "items": {
                  "properties": {
                    "start_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "words": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "VisualObservation": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "onscreen_text": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 40
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "observation_id",
        "frame_id",
        "timestamp_ms",
        "description",
        "onscreen_text",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Visual": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "frame_set_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VisualObservation"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "available",
        "frame_set_id",
        "observations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "frame_set_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "observations": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "frame_set_id": {
                "type": "null"
              },
              "observations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "CopySegment": {
      "type": "object",
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "transcript_segment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "pain_point",
              "audience",
              "product_intro",
              "selling_point",
              "proof",
              "scenario",
              "offer",
              "call_to_action",
              "other"
            ]
          },
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true
        },
        "start_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "allOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "properties": {
                "basis": {
                  "const": "inferred"
                }
              }
            }
          ]
        }
      },
      "required": [
        "segment_id",
        "transcript_segment_ids",
        "roles",
        "start_ms",
        "end_ms",
        "purpose"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "start_ms": {
              "type": "integer",
              "minimum": 0
            },
            "end_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "properties": {
            "start_ms": {
              "type": "null"
            },
            "end_ms": {
              "type": "null"
            }
          }
        }
      ]
    },
    "Copy": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "completed",
            "unavailable",
            "skipped"
          ]
        },
        "summary": {
          "$ref": "#/$defs/Claim"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CopySegment"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "structure_pattern": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "summary",
        "segments",
        "structure_pattern"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "segments": {
                "minItems": 1
              },
              "structure_pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "else": {
            "properties": {
              "segments": {
                "maxItems": 0
              },
              "structure_pattern": {
                "type": "null"
              },
              "summary": {
                "properties": {
                  "basis": {
                    "const": "unknown"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "FormatTag": {
      "allOf": [
        {
          "$ref": "#/$defs/Claim"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "talking_head",
                "product_demo",
                "animation_3d",
                "subtitle_driven",
                "mixed"
              ]
            },
            "basis": {
              "enum": [
                "observed",
                "inferred"
              ]
            }
          }
        }
      ]
    },
    "Tags": {
      "type": "object",
      "properties": {
        "format_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormatTag"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "origin": {
          "allOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "clip",
                    "suspected_clip",
                    "original",
                    null
                  ]
                }
              }
            }
          ]
        },
        "topic_tags": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/Claim"
              },
              {
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "basis": {
                    "enum": [
                      "observed",
                      "inferred"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 6
        }
      },
      "required": [
        "format_tags",
        "origin",
        "topic_tags"
      ],
      "additionalProperties": false
    },
    "Technique": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "question",
            "pain_point",
            "benefit",
            "suspense",
            "direct_demo",
            "other"
          ]
        },
        "analysis": {
          "allOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "properties": {
                "basis": {
                  "const": "inferred"
                }
              }
            }
          ]
        }
      },
      "required": [
        "type",
        "analysis"
      ],
      "additionalProperties": false
    },
    "Hook": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "available",
            "limited",
            "unknown",
            "skipped"
          ]
        },
        "window_start_ms": {
          "const": 0
        },
        "window_end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3000
        },
        "timing_precision": {
          "enum": [
            "word",
            "sentence",
            "none"
          ]
        },
        "spoken_excerpt": {
          "$ref": "#/$defs/Claim"
        },
        "onscreen_text": {
          "$ref": "#/$defs/Claim"
        },
        "visual_summary": {
          "$ref": "#/$defs/Claim"
        },
        "techniques": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Technique"
          },
          "minItems": 0,
          "maxItems": 6
        },
        "explanation": {
          "$ref": "#/$defs/Claim"
        },
        "boundary_unresolved": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 40
        }
      },
      "required": [
        "status",
        "window_start_ms",
        "window_end_ms",
        "timing_precision",
        "spoken_excerpt",
        "onscreen_text",
        "visual_summary",
        "techniques",
        "explanation",
        "boundary_unresolved",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "workflow_version": {
          "const": "content-v0.3"
        },
        "prompt_version": {
          "const": "content-prompts-v0.1"
        },
        "taxonomy_version": {
          "const": "content-tags-v0.1"
        },
        "video_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transcript_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "returned_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_call_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 100
        },
        "is_fixture": {
          "type": "boolean"
        }
      },
      "required": [
        "workflow_version",
        "prompt_version",
        "taxonomy_version",
        "video_sha256",
        "transcript_sha256",
        "returned_model",
        "generated_at",
        "model_call_ids",
        "is_fixture"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "content-1.0"
        },
        "kind": {
          "const": "content_report"
        },
        "analysis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "video_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "skipped"
          ]
        },
        "input_mode": {
          "enum": [
            "asr",
            "manual",
            "fixture",
            "missing"
          ]
        },
        "scope": {
          "enum": [
            "in_scope",
            "excluded",
            "undetermined"
          ]
        },
        "scope_reason": {
          "$ref": "#/$defs/Claim"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "scope_hint": {
              "enum": [
                "auto",
                "speech_content",
                "pure_display",
                "3d_showcase"
              ]
            },
            "origin_hint": {
              "enum": [
                "unknown",
                "clip",
                "original"
              ]
            }
          },
          "required": [
            "scope_hint",
            "origin_hint"
          ],
          "additionalProperties": false
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transcript"
            },
            {
              "type": "null"
            }
          ]
        },
        "visual": {
          "$ref": "#/$defs/Visual"
        },
        "copy": {
          "$ref": "#/$defs/Copy"
        },
        "tags": {
          "$ref": "#/$defs/Tags"
        },
        "hook": {
          "$ref": "#/$defs/Hook"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0,
          "maxItems": 40
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "analysis_id",
        "video_id",
        "duration_ms",
        "status",
        "input_mode",
        "scope",
        "scope_reason",
        "metadata",
        "transcript",
        "visual",
        "copy",
        "tags",
        "hook",
        "limitations",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "input_mode": {
                "const": "fixture"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "is_fixture": {
                    "const": true
                  }
                }
              },
              "transcript": {
                "allOf": [
                  {
                    "$ref": "#/$defs/Transcript"
                  },
                  {
                    "properties": {
                      "source": {
                        "const": "fixture"
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "properties": {
                  "is_fixture": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input_mode": {
                "const": "asr"
              }
            }
          },
          "then": {
            "properties": {
              "transcript": {
                "allOf": [
                  {
                    "$ref": "#/$defs/Transcript"
                  },
                  {
                    "properties": {
                      "source": {
                        "const": "asr"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input_mode": {
                "const": "manual"
              }
            }
          },
          "then": {
            "properties": {
              "transcript": {
                "allOf": [
                  {
                    "$ref": "#/$defs/Transcript"
                  },
                  {
                    "properties": {
                      "source": {
                        "const": "manual"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "input_mode": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "transcript": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/Transcript"
                      },
                      {
                        "properties": {
                          "source": {
                            "const": "media_probe"
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "const": "excluded"
              },
              "copy": {
                "properties": {
                  "status": {
                    "const": "skipped"
                  }
                }
              },
              "hook": {
                "properties": {
                  "status": {
                    "const": "skipped"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "copy": {
                "properties": {
                  "status": {
                    "const": "completed"
                  }
                }
              },
              "hook": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
